#include "protodunevd_g4_stage1.fcl"

services.Geometry: @local::protodunevd_v5_pns_geo


services.LArG4Detector.gdmlFileName_: "protodunevd_v5_ggd_PNS.gdml"
services.LArG4Detector.volumeNames: [
    "volDetEnclosure"
]
services.LArG4Detector.stepLimits: [ 1 ]

services.LArG4Parameters.KeepEMShowerDaughters: true

services.ParticleListAction.keepGenTrajectories: []
# this needs to be empty to set keepEMShowerDaughters to true
services.ParticleListAction.KeepDroppedParticlesInVolumes: []

services.ParticleListAction.keepEMShowerDaughters: true

physics.simulate: [ rns, largeant ]
